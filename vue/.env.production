# ============================================
# 前端应用环境变量配置 (生产环境)
# ============================================
# 此文件会被打包到 Docker 镜像中
# ============================================

# 环境标识
NODE_ENV=production

# API 基础地址
# 通过 Caddy 反向代理，使用相对路径 /api
# Caddy 会将 /api/* 请求转发到后端服务器
VITE_API_BASE_URL=/api

# 应用配置
VITE_APP_TITLE=ECEX移动端
VITE_APP_VERSION=1.0.0

# 其他配置（可选）
# VITE_APP_DESCRIPTION=ECEX移动端应用

