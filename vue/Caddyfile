# Caddyfile - 前端服务配置
{
    # 全局选项
    admin off
    # 自动 HTTPS（需要配置域名）
    # email your-email@example.com
}

# 主站点配置 - HTTP (自动重定向到 HTTPS)
ecex.cc:80 {
    # 重定向所有 HTTP 请求到 HTTPS
    redir https://ecex.cc{uri} permanent
}

# HTTPS 配置
ecex.cc {
    # API 反向代理到后端（必须放在最前面，优先匹配）
    handle /api/* {
        uri strip_prefix /api
        reverse_proxy http://172.16.0.87:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # 前端静态文件服务
    handle {
        root * /usr/share/caddy
        encode gzip
        try_files {path} /index.html
        file_server
    }

    # 安全头部
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:;"
        -Server
    }

    # 静态资源缓存
    @static {
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # 访问日志
    log {
        output file /var/log/caddy/access.log
        format json
    }
}

# 管理后台 - admin.ecex.cc
admin.ecex.cc {
    # 反向代理到后端管理后台服务
    reverse_proxy http://172.16.0.87:8097 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # 安全头部
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        -Server
    }

    # 访问日志
    log {
        output file /var/log/caddy/admin-access.log
        format json
    }
}

