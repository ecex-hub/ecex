# ============================================
# 后端服务器环境变量配置
# ============================================
# 请根据实际情况修改以下配置
# ============================================

# 数据库配置
DB_NAME=ecex
DB_USER=root
# ⚠️ 重要: 请修改为强密码 (建议至少16位,包含大小写字母、数字、特殊字符)
DB_PASSWORD=EcEx@MySQL#2026!Prod$Secure

# Redis 配置
# ⚠️ 重要: 请修改为强密码
REDIS_PASSWORD=EcEx@Redis#2026!Cache$Strong

# GitHub Container Registry 认证信息（用于拉取镜像）
# 你的 GitHub 用户名或组织名
GITHUB_USERNAME=ecex-hub
# 你的 GitHub Personal Access Token (需要 read:packages 权限)
# ⚠️ 重要: 请替换为你的实际 Token
GITHUB_TOKEN=ghp_your_token_here_replace_this

