# ============================================
# 前端服务器环境变量配置
# ============================================
# 请根据实际情况修改以下配置
# ============================================

# 后端服务器内网地址
# ⚠️ 重要: 请替换为后端服务器的实际内网 IP 地址
# 格式: 内网IP:端口
# 示例: 172.16.0.100:8080 或 192.168.1.100:8080
BACKEND_HOST=172.16.0.100:8080

# GitHub Container Registry 认证信息（用于拉取镜像）
# 你的 GitHub 用户名或组织名
GITHUB_USERNAME=ecex-hub
# 你的 GitHub Personal Access Token (需要 read:packages 权限)
# ⚠️ 重要: 请替换为你的实际 Token
GITHUB_TOKEN=ghp_your_token_here_replace_this

