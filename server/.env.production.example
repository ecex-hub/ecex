# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ecex
DB_USER=root
DB_PASSWORD=your_strong_mysql_password_here

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here

# 应用配置
YII_DEBUG=false
YII_ENV=prod

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# 支付配置（根据实际情况填写）
ALIPAY_APP_ID=
ALIPAY_PUBLIC_KEY=
ALIPAY_PRIVATE_KEY=

WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_KEY=

# 其他配置
UPLOAD_PATH=/var/www/html/backend/web/uploads
FRONTEND_URL=https://your-domain.com

