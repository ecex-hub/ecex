# ============================================
# 后端应用环境变量配置 (生产环境)
# ============================================
# 此文件会被打包到 Docker 镜像中
# ============================================

# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ecex
DB_USER=root
# ⚠️ 重要: 此密码必须与 deploy/backend/.env 中的 DB_PASSWORD 一致
DB_PASSWORD=EcEx@MySQL#2026!Prod$Secure

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
# ⚠️ 重要: 此密码必须与 deploy/backend/.env 中的 REDIS_PASSWORD 一致
REDIS_PASSWORD=EcEx@Redis#2026!Cache$Strong

# 应用配置
YII_DEBUG=false
YII_ENV=prod

# JWT 密钥（用于生成和验证 JWT Token）
# ⚠️ 重要: 请修改为随机字符串,至少32位
JWT_SECRET=EcEx@JWT#Secret$2026!ProductionKey@Secure#Random

# 支付配置（根据实际情况填写）
# 支付宝配置
ALIPAY_APP_ID=
ALIPAY_PUBLIC_KEY=
ALIPAY_PRIVATE_KEY=

# 微信支付配置
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_KEY=

# 文件上传路径
UPLOAD_PATH=/var/www/html/backend/web/uploads

# 前端 URL（用于生成链接、CORS 等）
# ⚠️ 重要: 请替换为你的实际域名
FRONTEND_URL=https://your-domain.com

