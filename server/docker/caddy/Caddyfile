# 开发环境配置（HTTP）
:80 {
    # 根目录
    root * /var/www/html/backend/web
    
    # PHP-FPM配置
    php_fastcgi localhost:9000 {
        root /var/www/html/backend/web
    }
    
    # 文件服务
    file_server
    
    # 启用Gzip压缩
    encode gzip
    
    # 静态资源缓存
    @static {
        path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
    }
    header @static Cache-Control "public, max-age=2592000"
    
    # 隐藏敏感文件
    @hidden {
        path */.*
    }
    respond @hidden 404
    
    # 日志
    log {
        output stdout
        format console
    }
}

# 生产环境配置（HTTPS自动）
