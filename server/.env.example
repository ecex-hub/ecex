# 数据库配置
DB_HOST=mysql
DB_PORT=3306
DB_NAME=stock
DB_USER=root
DB_PASSWORD=your_secure_password_here

# Redis配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0

# 应用配置
YII_ENV=Production
YII_DEBUG=false

# 阿里云短信服务配置
# 请在生产环境中设置真实的AccessKey
ALIYUN_ACCESS_KEY_ID=your_access_key_id_here
ALIYUN_ACCESS_KEY_SECRET=your_access_key_secret_here

